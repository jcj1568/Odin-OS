SLACK_APP_TOKEN=xapp-xxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_DEFAULT_CHANNEL=#odin-internal
