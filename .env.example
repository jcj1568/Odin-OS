# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Odin runtime ---
ODIN_MODEL_DEFAULT=claude-sonnet-4-6
ODIN_MODEL_ESCALATION=claude-opus-4-7
ODIN_PERMISSION_MODE=default              # default | acceptEdits | plan | bypassPermissions
ODIN_UNSUPERVISED_MODE=read_draft_only    # read_draft_only | full — do NOT set to full before Phase 0 exit criteria

# --- Venture scoping (Hymdal is the only venture right now) ---
ODIN_VENTURE=hymdal

# --- Supabase (Hymdal venture schema) — no live project yet ---
