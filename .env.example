SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SCHEMA=hymdal

# --- n8n (self-hosted, same VPS eventually) ---
N8N_BASE_URL=https://n8n.example.com
N8N_WEBHOOK_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Slack (James's own workspace) — no app registered yet ---
